{
  "name": "swag",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.dev.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch:check": "node scripts/arch-check.ts",
    "spec:check": "node scripts/spec-check.ts",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run arch:check && npm run build && npm run test && npm run spec:check",
    "up": "docker compose up -d --build --wait",
    "dev": "docker compose -f compose.yaml -f compose.dev.yaml up --build --watch",
    "down": "docker compose down",
    "infra:check": "node --env-file-if-exists=.env scripts/infra-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
