# Только для локальной разработки: учётные данные ниже не используются нигде, кроме локального compose.
# Скопируйте в .env (он в .gitignore) и не коммитьте.

POSTGRES_USER=swag
POSTGRES_PASSWORD=swag-local
POSTGRES_DB=swag

# Тесты адаптера Postgres и apps/api (спека 003, 4.6): база на опубликованном порте compose. Без неё тесты пропускаются.
POSTGRES_TEST_URL=postgres://swag:swag-local@127.0.0.1:5432/swag

# Адреса сервисов внутри сети compose. `npm run infra:check` запускается с хоста
# и подставляет 127.0.0.1 вместо имени хоста: порты опубликованы на тех же номерах.
DATABASE_URL=postgres://swag:swag-local@postgres:5432/swag
NATS_URL=nats://nats:4222

API_PORT=3000
ORCHESTRATOR_PORT=3001
UI_PORT=4200

# Спека 001, 4.9. Лимиты и таймауты — env (Q-3), менять можно без правки кода.
ORCHESTRATOR_URL=http://orchestrator:3001
MAX_ACTIVE_SWARMS=3
SWARM_MAX_BUDGET_MICRO_USD=5000000
AGENT_MAX_TOKENS_LIMIT=65536

# Окружение агента для провайдера песочниц; для Docker — тег образа.
AGENT_TEMPLATE=swag-agent:dev
# Сеть compose (имя проекта swag + default) и адрес NATS изнутри контейнера агента.
DOCKER_AGENT_NETWORK=swag_default
DOCKER_AGENT_NATS_URL=nats://nats:4222
AGENT_START_TIMEOUT_MS=30000
SWARM_TIMEOUT_MS=300000

# Спека 022. Агентный цикл.
AGENT_MAX_STEPS=20
AGENT_MAX_TOKENS=8192
DOCKER_AGENT_LLM_GATEWAY_URL=http://llm-gateway:3002/v1
# Спека 004, 4.11. Внутренний API gateway для регистрации роя и закрытия (`/internal/*`), без /v1.
LLM_GATEWAY_URL=http://llm-gateway:3002

# Спека 016, 4.11. Телеметрия: OTLP только в Collector; пустой адрес — логи только в stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
LOG_LEVEL=info
TELEMETRY_FLUSH_TIMEOUT_MS=2000
# Адрес Collector изнутри песочницы агента (агент в той же сети compose, спека 005 закроет сеть).
DOCKER_AGENT_OTLP_ENDPOINT=http://otel-collector:4318
# Grafana (Tempo, Loki) только на 127.0.0.1; из UI — через прокси /grafana.
GRAFANA_PORT=3300
# Спека 003, 4.7. Срок хранения Loki, Tempo и Prometheus в lgtm: часы, не меньше 24h; прод — 168h.
TELEMETRY_RETENTION=24h

# Спека 002. LLM Gateway; профиль моделей: test (фейковый провайдер), dev, test-pay, prod.
LLM_PROFILE=test
LLM_GATEWAY_PORT=3002
LLM_GATEWAY_TOKEN=swag-local-gateway-token-not-secret-000
LITELLM_URL=http://litellm:4000
LLM_GATEWAY_UPSTREAM_TIMEOUT_MS=120000
LLM_GATEWAY_STARTUP_TIMEOUT_MS=60000
LLM_GATEWAY_BODY_LIMIT_BYTES=8388608
# Спека 004, 4.11. Цены из OpenRouter: период в мс, 0 — выключено; профиль test запросов не делает.
LLM_PRICES_REFRESH_MS=3600000
OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models

# Спека 012, 4.10–4.11. Identity: регистрация, вход, токены; почта — Mailpit в compose.
IDENTITY_PORT=3003
MAILPIT_UI_PORT=8025
IDENTITY_CONFIRM_URL=http://127.0.0.1:4200/auth/confirm
# Пустой ключ — выпускает `npm run identity:keys --write-env` (Q-2).
IDENTITY_JWT_PRIVATE_KEY=
IDENTITY_JWT_KID=dev-1
IDENTITY_ACCESS_TTL_S=900
IDENTITY_REFRESH_TTL_S=2592000
IDENTITY_CONFIRM_TTL_S=86400
IDENTITY_COOKIE_SECURE=false
IDENTITY_BODY_LIMIT_BYTES=16384
# Супервизор создаётся при старте, если его ещё нет (Q-3). Задавать обе переменные или ни одной.
IDENTITY_SUPERVISOR_EMAIL=
IDENTITY_SUPERVISOR_PASSWORD=
SMTP_URL=smtp://mailpit:1025
SMTP_TIMEOUT_MS=10000
MAIL_FROM="Swag <no-reply@swag.local>"

# Спека 024, 4.14. Доступ и организации: api проверяет токены по ключу identity и забирает отзывы; identity и api ходят друг к другу по внутреннему токену.
IDENTITY_URL=http://identity:3003
# Явно фейковые dev-значения (не короче 32 символов), не секреты.
IDENTITY_INTERNAL_TOKEN=swag-local-identity-internal-token-not-secret-000
# Пустой — заполняет `npm run identity:keys -- --write-env` (base64 от SPKI PEM, D-117).
IDENTITY_JWT_PUBLIC_KEY=
ORCHESTRATOR_TOKEN=swag-local-orchestrator-token-not-secret-000
API_REVOCATION_POLL_MS=5000
API_REVOCATION_MAX_STALE_MS=30000
IDENTITY_INVITE_URL=http://127.0.0.1:4200/auth/invite
IDENTITY_INVITE_TTL_S=604800

# Спека 012, 4.11 и T-18. Стек-тесты identity и почты: без этих переменных тесты `[stack]` пропускаются.
STACK_TEST_IDENTITY_URL=http://127.0.0.1:3003
STACK_TEST_MAILPIT_URL=http://127.0.0.1:8025

# Спека 002 и 004, D-102. Стек-тесты llm-gateway: без переменной пропускаются. Задавать при прогоне против `npm run up`.
# STACK_TEST_GATEWAY_URL=http://127.0.0.1:3002
