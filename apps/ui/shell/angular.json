{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "shell": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "cacheExternalArtifacts": true,
            "tsConfig": "tsconfig.federation.json"
          },
          "configurations": {
            "production": {
              "target": "shell:esbuild:production"
            },
            "development": {
              "target": "shell:esbuild:development",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "shell:serve-original:development",
            "tsConfig": "tsconfig.federation.json",
            "rebuildDelay": 500,
            "cacheExternalArtifacts": true,
            "dev": true,
            "devServer": true,
            "port": 0
          },
          "configurations": {
            "container": {
              "target": "shell:serve-original:container"
            }
          }
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "outputPath": "dist/shell",
            "tsConfig": "tsconfig.app.json",
            "styles": ["@swag/ui-angular/styles/tokens.css", "@swag/ui-angular/styles/base.css"],
            "assets": [{ "glob": "**/*", "input": "public" }],
            "polyfills": ["es-module-shims"]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "host": "127.0.0.1",
            "port": 4200
          },
          "configurations": {
            "development": {
              "buildTarget": "shell:esbuild:development"
            },
            "container": {
              "buildTarget": "shell:esbuild:development",
              "host": "0.0.0.0"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
