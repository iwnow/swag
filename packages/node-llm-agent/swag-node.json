{
  "type": "swag/llm-agent",
  "version": "1.0.0",
  "kind": "llm-agent",
  "title": "LLM-агент",
  "description": "Агент на модели платформы: роль, модель, бюджет и лимит ответа. Исполняется агентным циклом платформы.",
  "settings": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "role": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "model": {
        "default": "chat-small",
        "type": "string",
        "enum": [
          "chat-small",
          "chat-large"
        ]
      },
      "budgetMicroUsd": {
        "default": null,
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          {
            "type": "null"
          }
        ]
      },
      "maxTokens": {
        "default": null,
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "name",
      "role"
    ],
    "additionalProperties": false
  },
  "credentials": [],
  "inputs": null,
  "outputs": null,
  "operations": [],
  "egress": []
}
